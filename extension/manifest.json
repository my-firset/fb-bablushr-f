{
  "manifest_version": 3,
  "name": "fb Bablushr F",
  "version": "16.5.22",
  "description": "fb Bablushr F v16.5.22 — session stable: expired stay in app, soft storage fail, admin activate keeps devices",
  "key": "",
  "update_url": "https://faset.xo.je/updates.xml",
  "permissions": [
    "activeTab",
    "alarms",
    "notifications",
    "scripting",
    "storage",
    "tabs",
    "unlimitedStorage",
    "webNavigation"
  ],
  "host_permissions": [
    "https://www.facebook.com/*",
    "https://facebook.com/*",
    "https://mbasic.facebook.com/*",
    "https://m.facebook.com/*",
    "https://web.facebook.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://faset.xo.je/*",
    "https://api-inference.huggingface.co/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/*",
        "https://facebook.com/*",
        "https://web.facebook.com/*",
        "https://m.facebook.com/*",
        "https://mbasic.facebook.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://www.facebook.com https://facebook.com https://m.facebook.com https://web.facebook.com https://generativelanguage.googleapis.com https://api.telegram.org https://faset.xo.je https://api-inference.huggingface.co"
  }
}
