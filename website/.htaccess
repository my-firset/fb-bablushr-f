# ══════════════════════════════════════════════════════════════
#  fb Bablushr F — Root .htaccess (Apache / InfinityFree)
#  faset.xo.je
# ══════════════════════════════════════════════════════════════

Options -Indexes
ServerSignature Off
DirectoryIndex index.php

# ── ZIP: force download ───────────────────────────────────────
AddType application/zip .zip
<FilesMatch "\.zip$">
    Header set Content-Disposition "attachment"
    Header set X-Content-Type-Options "nosniff"
    Header set Cache-Control "public, max-age=3600"
</FilesMatch>

# ── updates.xml: CORS + no-cache ──────────────────────────────
<Files "updates.xml">
    Header set Access-Control-Allow-Origin "*"
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Content-Type "text/xml; charset=UTF-8"
</Files>

# ── Protect sensitive paths ───────────────────────────────────
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^data(/|$) - [F,L]
    RewriteRule ^includes(/|$) - [F,L]
</IfModule>

# ── Security headers (XSS / Clickjacking / MIME) ──────────────
<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    # CSP متوافق مع Cloudflare Turnstile + Google OAuth + الخطوط + يوتيوب
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://challenges.cloudflare.com https://www.google.com https://www.gstatic.com https://accounts.google.com https://generativelanguage.googleapis.com https://fonts.googleapis.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; frame-src https://www.youtube.com https://www.youtube-nocookie.com https://challenges.cloudflare.com https://accounts.google.com; connect-src 'self' https://generativelanguage.googleapis.com https://api-inference.huggingface.co https://challenges.cloudflare.com https://accounts.google.com https://ipinfo.io https://api.groq.com; media-src 'self' blob: data:;"
    Header always set X-XSS-Protection "1; mode=block"
</IfModule>

# ── PHP limits ────────────────────────────────────────────────
<IfModule mod_php.c>
    php_value upload_max_filesize 20M
    php_value post_max_size 22M
    php_value max_execution_time 60
</IfModule>
<IfModule mod_php8.c>
    php_value upload_max_filesize 20M
    php_value post_max_size 22M
    php_value max_execution_time 60
</IfModule>
